extends index

block content
    .home-image
        img(src="data:image/jpg;base64," + ipsumImage, width="200" height="300")

    .input-group
        input(type="text" maxlength=140 placeholder="Todo ..." id="myInput")
        button(type="button") Insert

    h3 Todo
    ul.todo-list#todos
        each item in todos.pending
            li(data-id=item.id)
              = item.action
              button.mark_done-btn(data-id=item.id) Mark as done

    h3 Ready
    ul.todo-list#todos
        each item in todos.done
            li(data-id=item.id)
                = item.action